# Database & Application Configuration for Sitanagri Mart

# Database Type: mysql, oracle, or sqlite (default: mysql)
DB_TYPE=mysql

# Database Host & Port (for mysql / oracle)
DB_HOST=localhost
DB_PORT=3306

# Database Name (for mysql: sitanagri_mart or grocery)
DB_NAME=sitanagri_mart

# Database Credentials
DB_USER=root
DB_PASSWORD=

# Alternative JDBC URL (Overridden if specified)
# DB_URL=jdbc:mysql://localhost:3306/sitanagri_mart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Oracle Configuration Example (uncomment if using Oracle):
# DB_TYPE=oracle
# DB_HOST=localhost
# DB_PORT=1521
# DB_NAME=XE
# DB_USER=grocery
# DB_PASSWORD=grocery
